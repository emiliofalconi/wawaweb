# ==============================================================================
# Variables de Entorno - WawaWeb (Configuración para Producción y Despliegue Web)
# ==============================================================================

# Puerto asignado por el hosting en la nube (Render, Railway, Fly.io, Cloud Run)
PORT=8080

# Dirección de enlace de red (0.0.0.0 para contenedores o servicios web públicos)
HOST=0.0.0.0

# Ruta persistente de la base de datos relacional SQLite (3FN)
DATABASE_PATH=wawaweb.db

# Clave secreta criptográfica para la firma de tokens de autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_de_produccion_2026

# Evitar apertura automática del navegador en servidores Linux headless
NO_BROWSER=1

